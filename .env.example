# Copier ce fichier vers .env puis renseigner les valeurs réelles.
# Le fichier .env ne doit jamais être commité.

# Backend / Supabase
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-legacy-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=

# Variables publiques injectées lors du build Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
